mixin searchBox(search) 
    form(id="form-search") 
        div(class="border rounded-2xl px-2 py-1 flex items-center justify-center gap-2 text-sm text-n-500 border-n-500")
            i(class="fa-solid fa-magnifying-glass")
            input(type="text" class="outline-none" id="search" value=search placeholder="Search..." )