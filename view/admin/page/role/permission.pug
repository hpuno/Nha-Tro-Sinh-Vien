extends ../../layout/default.pug
include ../../mixin/search.pug
include ../../mixin/filter-status.pug
include ../../mixin/alert.pug

block main-content
    +successAlert(3000)
    +errorAlert(3000)

    div(class="container mt-10 w-[700px]")
    
        div(class="relative flex flex-col gap-4 px-6 shadow-n-800 shadow-xs px-4 py-8 rounded-md ") 

            if(nhan_vien.NV_TRANGTHAI == "active")
                div(class="absolute top-5 right-10") 
                    div(class="flex items-center justify-center gap-2 font-inter text-p-500")
                        div(class="relative flex size-3")
                            span(class="absolute inline-flex h-full w-full animate-ping rounded-full bg-p-500 opacity-75")
                            span(class="relative inline-flex size-3 rounded-full bg-p-500")
                        p Hoạt động 
            else 
                div(class="absolute top-5 right-10") 
                    div(class="flex items-center justify-center gap-2 font-inter text-red-600")
                        div(class="relative flex size-3")
                            span(class="absolute inline-flex h-full w-full animate-ping rounded-full bg-p-500 opacity-75")
                            span(class="relative inline-flex size-3 rounded-full bg-red-600")
                        p Dừng hoạt động 

            div(class="flex items-center gap-5 mb-10") 
                img(src=nhan_vien.NV_ANH alt=nhan_vien.NV_TEN class="h-25 w-25 object-cover p-1 bg-n-200 rounded-full")
                div(class="flex flex-col -gap-1") 
                    div(class="flex items-center gap-2") 
                        h3(class="text-n-800 leading-tight font-inter text-xl font-semibold") #{nhan_vien.NV_TEN}
                        div(class="flex items-center gap-2 font-inter text-n-800 bg-p-100 px-2 text-sm rounded-xl") 
                            i(class="fa-solid fa-address-card")
                            p NV #[span #{nhan_vien.NV_ID}]
                    div(class="font-inter text-xs text-n-800")
                        span keycloak_ID: 
                        span #{nhan_vien.NV_keycloak}

                
            div(class="absolute left-0 right-0 border border-n-200 top-40")

            form(action=`/admin/role/permission/${nhan_vien.NV_ID}?_method=PATCH` method="post")  
                div(class="grid grid-cols-2 gap-4 px-6")

                    .form-group
                        .form-control_info       
                            label(for="CV_ID") #[span.text-red-500 * ]Chức vụ
                            select(name="CV_ID" id="CV_ID" )
                                each item in chuc_vu
                                    option(value=item.CV_ID selected=((phan_cong.length>0)?(phan_cong[0].CV_ID==item.CV_ID):"")) #{item.CV_TEN}   
                    .form-group
                        .form-control_info 
                            label(for="NT_ID") #[span.text-red-500 * ]Nhà trọ quản lý
                            each item in nha_tro
                                div(class="flex item-center gap-2 px-8")
                                    input(type="checkbox" id=item.NT_ID name="NT_ID" value=item.NT_ID checked=item.selected)
                                    label(for=item.NT_ID).text-n-800.font-semibold #{item.NT_TEN}
                div(class="flex items-center justify-around mt-10") 
                    a(href="/admin/role" class="btn-2 py-1 text-base bg-gray-500") Quay về 
                    button(type="submit" class="btn-2 py-1 text-base") Xác nhận thay đổi
                             