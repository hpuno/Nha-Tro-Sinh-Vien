extends ../../layout/default.pug
include ../../mixin/alert.pug

block main-content
    +successAlert(3000)
    +errorAlert(3000)

    div(class="container mt-10 w-[1000px]")
    
        div(class="relative flex flex-col gap-4 px-6 shadow-n-800 shadow-xs px-4 py-8 rounded-md ") 
            
            form(action="/admin/employee/create" method="post" enctype="multipart/form-data")  

                div(class="grid grid-cols-2 gap-4 px-6")


                    div(class="flex items-center col-span-2 gap-2 font-inter text-lg ") 
                        i(class="fa-solid fa-user-gear").text-p-500
                        span.text-n-800.font-semibold Thông tin tài khoản

                    .form-group
                        .form-control_info                      
                            label(for="NV_EMAIL") #[span.text-red-500 * ]Email đăng nhập
                            input(type="text" id="NV_EMAIL" name="NV_EMAIL" required)

                        .form-control_info                      
                            label(for="NV_MATKHAU") #[span.text-red-500 * ]Mật khẩu
                            input(type="password" id="NV_MATKHAU" name="NV_MATKHAU" required)

                    .form-group
            
                        .form-control_info                          
                            label(for="NV_TRANGTHAI") #[span.text-red-500 * ]Trạng thái
                            select(name="NV_TRANGTHAI" required)
                                option(value="active" ) Hoạt động 
                                option(value="inactive") Dừng hoạt động

                        .form-control_info                      
                            label(for="NV_ReMATKHAU") #[span.text-red-500 * ]Nhập lại mật khẩu
                            input(type="password" id="NV_ReMATKHAU" name="NV_ReMATKHAU" required)

                    div(class="flex items-center col-span-2 gap-2 font-inter text-lg ") 
                        i(class="fa-solid fa-user").text-p-500
                        span.text-n-800.font-semibold Thông tin cá nhân

                    .form-control_info.col-span-2
                            div(class="flex items-center gap-5 bg-n-50 border border-n-200 rounded-xl py-4  px-8 w-fit")
                                
                                div(class="h-20 w-20 border border-dashed border-n-500 bg-n-100 rounded-md")
                                    input(type="file" preview-image-create id="NV_ANH" name="NV_ANH" accept="image/*"  class="hidden")
                                    img(preview-create class="h-full w-full object-cover")
                                
                                div(class="flex flex-col gap-1")
                                    span(class="font-inter text-n-800 font-semibold text-sm") Ảnh đại diện 
                                    span(class="font-inter text-n-500 text-xs") Tải lên ảnh đại diện.
                                    label(for="NV_ANH" class="px-2 py-1 bg-white font-semibold text-p-700 font-inter text-xs border border-p-500 rounded-md w-fit") Chọn ảnh
                    .form-group
                    
                        .form-control_info                      
                            label(for="NV_TEN") #[span.text-red-500 * ]Họ và tên
                            input(type="text" id="NV_TEN" name="NV_TEN" )

                        .form-control_info                      
                            label(for="NV_MASO_THUE") Mã số thuế
                            input(type="text" id="NV_MASO_THUE" name="NV_MASO_THUE" )

                        .form-control_info                          
                            label(for="NV_PHAI") Giới tính
                            select(name="NV_PHAI")
                                option(value="male") Nam 
                                option(value="female") Nữ  

                    .form-group 
                        
                        .form-control_info                      
                            label(for="NV_SDT") #[span.text-red-500 * ]Số điện thoại
                            input(type="text" id="NV_SDT" name="NV_SDT" )

                        .form-control_info                      
                            label(for="NV_CCCD") Căn cước công dân
                            input(type="text" id="NV_CCCD" name="NV_CCCD" )

                    .form-control_info.col-span-2                      
                        label(for="NV_DIACHI") Địa chỉ
                        textarea(id="NV_DIACHI" name="NV_DIACHI") 
            
                div(class="flex items-center justify-end mt-10 gap-4") 
                    a(href="/admin/employee" class="btn-2 py-1 text-base bg-gray-500") Hủy
                    button(type="submit" class="btn-2 py-1 text-base") Thêm mới
                
        