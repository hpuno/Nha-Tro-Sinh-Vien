extends ../../layout/default.pug
include ../../mixin/search.pug
include ../../mixin/filter-status.pug


block main-content

    div(class="container mt-10 w-[1000px]")
    
        div(class="relative grid grid-cols-2 gap-4 px-6 shadow-n-800 shadow-xs px-4 py-8 rounded-md ") 

            if(nhan_vien.NV_TRANGTHAI == "active")
                div(class="absolute top-5 right-10") 
                    div(class="flex items-center justify-center gap-2 font-inter text-p-500")
                        div(class="relative flex size-3")
                            span(class="absolute inline-flex h-full w-full animate-ping rounded-full bg-p-500 opacity-75")
                            span(class="relative inline-flex size-3 rounded-full bg-p-500")
                        p Hoạt động 
            else 
                div(class="absolute top-5 right-10") 
                    div(class="flex items-center justify-center gap-2 font-inter text-red-600")
                        div(class="relative flex size-3")
                            span(class="absolute inline-flex h-full w-full animate-ping rounded-full bg-p-500 opacity-75")
                            span(class="relative inline-flex size-3 rounded-full bg-red-600")
                        p Dừng hoạt động 

            div(class="col-span-2 flex items-center gap-5 mb-10") 
                img(src=nhan_vien.NV_ANH alt=nhan_vien.NV_TEN class="h-25 w-25 object-cover p-1 bg-n-200 rounded-full")
                div 
                    h3(class="text-n-800 font-inter text-xl font-semibold") #{nhan_vien.NV_TEN}
                    p(class="font-inter text-n-500 text-sm") #{chuc_vu?chuc_vu.CV_TEN:"_"} 
            
            div(class="absolute left-0 right-0 border border-n-200 top-40")

            div(class="col-span-2 flex items-center gap-2 mb-2 font-inter text-lg ") 
                i(class="fa-solid fa-user").text-p-500
                span.text-n-800.font-semibold Thông tin cá nhân
            .form-group

                div(class="px-8 font-inter")                    
                    span(class="text-n-500 text-xs") Họ và tên
                    h3(class="text-n-800 text-sm font-semibold") #{nhan_vien.NV_TEN}

                div(class="px-8 font-inter")                    
                    span(class="text-n-500 text-xs") Email đăng nhập
                    h3(class="text-n-600 text-sm font-semibold") #{nhan_vien.NV_EMAIL}

                div(class="px-8 font-inter")                    
                    span(class="text-n-500 text-xs") Giới tính
                    h3(class="text-n-800 text-sm font-semibold") #{nhan_vien.NV_PHAI?(nhan_vien.NV_PHAI == "male"?"Nam":"Nữ"):"_"}
            .form-group

                div(class="px-8 font-inter")                    
                    span(class="text-n-500 text-xs") Số điện thoại
                    h3(class="text-n-800 text-sm font-semibold") #{nhan_vien.NV_SDT?nhan_vien.NV_SDT:"_"}
                
                div(class="px-8 font-inter")                    
                    span(class="text-n-500 text-xs") Căn cước công dân
                    h3(class="text-n-800 text-sm font-semibold") #{nhan_vien.NV_CCCD?nhan_vien.NV_CCCD:"_"}

                div(class="px-8 font-inter")                    
                    span(class="text-n-500 text-xs") Địa chỉ
                    h3(class="text-n-800 text-sm font-semibold") #{(nhan_vien.NV_DIACHI)?nhan_vien.NV_DIACHI:"_"}
            
            div(class="col-span-2 flex items-center gap-2 my-2 font-inter text-lg ") 
                i(i class="fa-solid fa-user-tag").text-p-500
                span.text-n-800.font-semibold Thông tin quản lý

            .form-group
                div(class="px-8 font-inter")  
                    span(class="text-n-500 text-xs") Chức vụ
                    h3(class="text-n-800 text-sm font-semibold") #{chuc_vu?chuc_vu.CV_TEN:"_"}
            
            .form-group    
                div(class="px-8 font-inter")  
                    span(class="text-n-500") Quản lý
                    each item in nha_tro 
                        h3(class="text-n-800 text-sm font-semibold") #{item.NT_TEN?item.NT_TEN:"_"}
            
            div(class="col-span-2 flex items-center gap-2 my-2 font-inter text-lg ") 
                i(class="fa-solid fa-user-gear").text-p-500
                span.text-n-800.font-semibold Thông tin tài khoản

            div(class="col-span-2 px-8")
                div(class="grid grid-cols-[0.5fr_1fr_0.5fr] gap-5")
                    div(class="bg-n-50 rounded-md border border-n-200 px-2 py-4 font-inter")
                        h3(class="text-n-500 text-xs") Mã khách thuê
                        p(class="text-n-800 font-semibold text-sm") ##{nhan_vien.NV_ID}
                    div(class="bg-n-50 rounded-md border border-n-200 px-2 py-4 font-inter") 
                        h3(class="text-n-500 text-xs") Mã keycloak
                        p(class="text-n-800 font-semibold text-sm") #{nhan_vien.NV_keycloak} 
                    div(class="bg-n-50 rounded-md border border-n-200 px-2 py-4 font-inter")
                        h3(class="text-n-500 text-xs") Ngày tạo tài khoản
                        p(class="text-n-800 font-semibold text-sm") #{nhan_vien.NV_NGAYTAO}
            div(class="col-span-2 flex items-center justify-center")
                a(href="/admin/employee" class="btn-2 px-2 py-1 bg-gray-500 mt-5") Quay lại
    
                
        