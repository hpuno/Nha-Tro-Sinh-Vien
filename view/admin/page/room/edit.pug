extends ../../layout/default.pug
include ../../mixin/search.pug
include ../../mixin/filter-status.pug
include ../../mixin/alert.pug

block main-content
    +successAlert(3000)
    +errorAlert(3000)

    div(class="container mt-10 w-[800px]")
    
        div(class="relative flex flex-col gap-4 px-6 shadow-n-800 shadow-xs px-4 py-8 rounded-md ") 
            
            form(action=`/admin/room/edit/${phong.P_ID}?_method=PATCH` method="post" enctype="multipart/form-data")  

                div(class="grid grid-cols-2 gap-4 px-6")

                    div(class="flex items-center col-span-2 gap-2 font-inter text-lg ") 
                        i(class="fa-solid fa-building-user")
                        span.text-n-800.font-semibold Thông tin phòng trọ

                    .form-control_info.col-span-2
                            div(class="flex items-center gap-5 bg-n-50 border border-n-200 rounded-xl py-4  px-8 w-fit")
                                
                                div(class="h-20 w-20 border border-dashed border-n-500 bg-n-100 rounded-md")
                                    input(type="file" preview-image-create id="P_ANH" name="P_ANH" accept="image/*" class="hidden")
                                    img(src=phong.P_ANH preview-create class=`h-full w-full object-cover ${phong.P_ANH?"":"hidden"}`)
                                
                                div(class="flex flex-col gap-1")
                                    span(class="font-inter text-n-800 font-semibold text-sm") Ảnh phòng trọ 
                                    span(class="font-inter text-n-500 text-xs") Tải lên ảnh phòng trọ.
                                    label(for="P_ANH" class="px-2 py-1 bg-white font-semibold text-p-700 font-inter text-xs border border-p-500 rounded-md w-fit") Chọn ảnh
                    .form-group
                        div(class="form-control_info w-3/4")          
                            label(for="P_TEN") #[span.text-red-500 * ]Mã phòng
                            input(type="text" id="P_TEN" name="P_TEN" value=phong.P_TEN placeholder="VD: P101,..." required)

                        div(class="form-control_info w-1/2")          
                            label(for="P_SL") #[span.text-red-500 * ]Số lượng người ở
                            input(type="number" id="P_SL" min=1 value=phong.P_SL name="P_SL" required)

                        div(class="form-control_info w-1/2")               
                            label(for="P_GIA") #[span.text-red-500 * ]Giá (VND)
                            input(type="text" change-price-format format-price-input id="P_GIA" name="P_GIA" value=phong.P_GIA required) 

                    .form-group

                        .form-control_info          
                            label(for="NT_ID") #[span.text-red-500 * ]Nhà trọ
                            select(name="NT_ID" required)
                                each item in nha_tro
                                    option(value=item.NT_ID selected=(item.NT_ID == phong.NT_ID)) #{item.NT_TEN} 

                        .form-control_info.w-fit                    
                            label(for="P_DIENTICH") #[span.text-red-500 * ]Diện tích (m #[sup 2])
                            input(type="text" id="P_DIENTICH" min=1 name="P_DIENTICH" value=phong.P_DIENTICH required) 
                               

                        .form-control_info          
                            label(for="P_TRANGTHAI") #[span.text-red-500 * ]Trạng thái
                            select(name="P_TRANGTHAI" required)
                                option(value="active" selected=(phong.P_TRANGTHAI=="active")) Hoạt động 
                                option(value="inactive" selected=(phong.P_TRANGTHAI=="inactive")) Dừng hoạt động

                    .form-control_info.col-span-2                 
                        label(for="P_MOTA") Địa chỉ
                        textarea(id="P_MOTA" name="P_MOTA") #{phong.P_MOTA} 

                div(class="flex items-center justify-around mt-10") 
                    a(href="/admin/room" class="btn-2 py-1 text-base bg-gray-500") Quay về 
                    button(type="submit" class="btn-2 py-1 text-base") Xác nhận thay đổi
                    a(href="javascript:;"  button-delete id=phong.P_ID class="btn-2 py-1 text-base bg-red-600") Xóa phòng trọ
    // delete
    form(action=""
        method="POST"
        path="/admin/room/delete"
        id="form-delete") 