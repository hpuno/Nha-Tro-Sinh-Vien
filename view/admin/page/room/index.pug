extends ../../layout/default.pug
include ../../mixin/search.pug
include ../../mixin/filter-status.pug
include ../../mixin/pagination.pug
include ../../mixin/alert.pug

block main-content
    +errorAlert(3000)
    +successAlert(3000)

    .container.mt-10

        div(class="flex justify-end mb-5")
            a(href="/admin/room/create") 
                div(class="flex items-center gap-2 font-inter bg-n-500 px-4 py-2 rounded-2xl text-n-50 hover:bg-n-200 hover:text-n-500 trasition-all duration-200") 
                    span Thêm mới 
                    i(class="fa-solid fa-plus")
        div(class="p-4 bg-n-50 rounded-2xl border border-n-200")
            
            div(class="flex items-center justify-end mb-5")    
                button(export-file class="font-inter text-lg text-n-800 hover:bg-n-50 ")  
                    i(class="fa-solid fa-download")
            
            div(class="flex items-center justify-between mb-10")
                h2(class="font-inter font-semibold text-xl text-n-800") Danh sách phòng trọ
                div(class="flex items-center gap-2") 
                    +searchBox(search)
                    +filterStatus(filterStatus)
            table.table-admin
                thead
                    tr
                        th Phòng
                        th Nhà trọ
                        th Giá (VND) 
                        th Trạng thái
                        th Thao tác
                tbody
                    each item in phong 
                        tr  
                            td.relative 
                                if(rental.includes(item.P_ID))
                                    div(class="absolute top-5 -left-2 bg-red-700 text-red-50 font-inter text-[8px] px-1 rounded-2xl") Đang thuê
                                div(class="flex items-center gap-2") 
                                    img(src=item.P_ANH alt=item.P_TEN class="h-[50px] w-[50px] object-cover rounded-xl")
                                    p #{item.P_TEN}
                            td #{item.NT_TEN}
                            td.format-price #{item.P_GIA }
                            td 
                                if(item.P_TRANGTHAI == "active")
                                    a(href="javascript:;" change-status id=item.P_ID status=item.P_TRANGTHAI class="px-2 py-1 font-inter text-xs bg-p-500 rounded-md text-p-50 hover:bg-p-700 ") active 
                                else    
                                    a(href="javascript:;" change-status id=item.P_ID status=item.P_TRANGTHAI class="px-2 py-1 font-inter text-xs bg-red-500 rounded-md text-p-50 hover:bg-red-700 ") inactive 

                            td
                                div(class="flex gap-4 text-lg ")
                                    // chi tiet
                                    a(href=`/admin/room/detail/${item.P_ID}`) 
                                        i(class="fa-solid fa-circle-info text-n-500 hover:text-n-800")
                                    // chinh sua
                                    a(href=`/admin/room/edit/${item.P_ID}`) 
                                        i(class="fa-solid fa-square-pen text-p-500 hover:text-p-700")
                                    // xoa
                                    a(href="javascript:;"  button-delete id=item.P_ID) 
                                        i(class="fa-solid fa-trash text-red-700 hover:text-red-800 text-lg")
                            
            // pagination
            +pagination(pagination)
    
    // change-status
    form(action=""
        method="POST"
        path="/admin/room/change-status"
        id="form-change-status") 
    
    // delete
    form(action=""
        method="POST"
        path="/admin/room/delete"
        id="form-delete")