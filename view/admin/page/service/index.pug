extends ../../layout/default.pug
include ../../mixin/search.pug
include ../../mixin/filter-status.pug
include ../../mixin/pagination.pug
include ../../mixin/alert.pug

block main-content
    +errorAlert(3000)
    +successAlert(3000)

    - const service = ["Điện", "Nước", "Lấy rác"]

    .container.mt-10
        div(class="grid grid-cols-[450px_1fr] gap-5")
            //- Danh sách chức vụ
            div
                div(class="p-4 bg-n-50 rounded-2xl border border-n-200" )

                    div(class="flex items-center justify-between")
                        h2(class="font-inter font-semibold text-xl text-n-800") Danh sách dịch vụ
                        a(href="/admin/service/create" class="px-2 py-1 bg-n-500 rounded-md text-sm text-n-50 hover:bg-n-200 hover:text-n-500 trasition-all duration-200") Thêm mới

                    table.table-admin
                        thead
                            tr
                                th Dịch vụ
                                th Giá
                                th Trạng thái
                                th Thao tác
                               
                        tbody
                            each item in dich_vu 
                                tr  
                                    td #{item.DV_TEN}
                                    td.format-price #{item.DV_GIA}
                                    td 
                                        if(item.DV_TRANGTHAI == "active")
                                            a(href="javascript:;" change-status id=item.DV_ID status=item.DV_TRANGTHAI class="px-2 py-1 font-inter text-xs bg-p-500 rounded-md text-p-50 hover:bg-p-700 ") active 
                                        else    
                                            a(href="javascript:;" change-status id=item.DV_ID status=item.DV_TRANGTHAI class="px-2 py-1 font-inter text-xs bg-red-500 rounded-md text-p-50 hover:bg-red-700 ") inactive 
                                    td
                                        div(class="flex gap-4 text-lg ")
                                            
                                            // chinh sua
                                            a(href=`/admin/service/edit/${item.DV_ID}`) 
                                                i(class="fa-solid fa-square-pen text-p-500 hover:text-p-700")
                                            if(!service.includes(item.DV_TEN))
                                                // xoa
                                                a(href="javascript:;"  button-delete id=item.DV_ID) 
                                                    i(class="fa-solid fa-trash text-red-700 hover:text-red-800 text-lg")
            
            //-  Phân quyền
            div
                
                div(class="p-4 bg-n-50 rounded-2xl border border-n-200")
                    
                    div(class="flex items-center gap-4 justify-end mb-5")    
                        a(href="/admin/service/create-use-service" class="px-2 py-1 bg-n-500 rounded-md text-sm text-n-50 hover:bg-n-200 hover:text-n-500 trasition-all duration-200") Thêm mới
                        
                        button(export-file class="font-inter text-lg text-n-800 hover:bg-n-50 ")  
                            i(class="fa-solid fa-download")
                    
                    div(class="flex items-center justify-between mb-10")
                        h2(class="font-inter font-semibold text-xl text-n-800") Danh sách sử dụng dịch vụ
                        div(class="flex items-center gap-2") 
                            +searchBox(search)
                            +filterStatus(filterMounthYear)
                    table.table-admin
                        thead
                            tr
                                th Phòng trọ
                                th Dịch vụ
                                th Tháng năm
                                th Trạng thái
                                th Thao tác

                        tbody
                            each item in sddv
                                tr 
                                    td #{item.P_TEN}
                                    td #{item.DV_TEN}
                                    td #{item.SDDV_THANGNAM}
                                    td 
                                        if(item.SDDV_TRANGTHAI == "active")
                                            a(href="javascript:;" class="px-2 py-1 font-inter text-xs bg-p-500 rounded-md text-p-50") active 
                                        else 
                                            a(href="javascript:;" class="px-2 py-1 font-inter text-xs bg-red-500 rounded-md text-red-50") active 

                                    td.text-center
                                        a(href="javascript:;"  button-delete-use-service idRoom=item.P_ID idService=item.DV_ID mouth-year=item.SDDV_THANGNAM)
                                            i(class="fa-solid fa-trash text-red-700 hover:text-red-800 text-lg")                             
                                     
                                        
                    // pagination
                    +pagination(pagination)

    // delete
    form(action=""
        method="POST"
        path="/admin/service/delete/use-serivce"
        id="form-delete-use-service")
    
    // change-status
    form(action=""
        method="POST"
        path="/admin/service/change-status"
        id="form-change-status") 
    
    // delete
    form(action=""
        method="POST"
        path="/admin/service/delete"
        id="form-delete")