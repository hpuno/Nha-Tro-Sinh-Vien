include ../../layout/defaultSign.pug
include ../../mixin/alert.pug

block main 
    +errorAlert(3000)
    section#reset-password 
        div(class="container flex items-center justify-center h-screen")

            div(class="py-8 px-16 bg-n-100 flex items-center")
                form(action="/user/reset-password?_method=PUT" method="post") 
                    .form-group
                        div(class="font-inter mb-2")
                            h2(class="text-2xl text-center") Thay đổi mật khẩu 
                            p(class="text-xs  text-n-500") Đừng chia sẽ mật khẩu cho người khác để tránh bị chiếm đoạt tài khoản bạn nhé.
                        
                        .form-control                         
                            label(for="KT_NewPassword") #[span.text-red-500 * ]Mật khẩu mới
                            input(type="password" id="KT_NewPassword" name="KT_NewPassword" placeholder="Nhập mật khẩu mới" required) 

                        .form-control                     
                            label(for="KT_ReNewPassword") #[span.text-red-500 * ]Nhập lại mật khẩu
                            input(type="password" id="KT_ReNewPassword" name="KT_ReNewPassword" placeholder="Nhập lại mật khẩu" required) 

                        .form-control 
                            button(type="submit" class="btn-2 self-center ") Xác nhận thay đổi

            