extends ../../layout/defaultUser.pug

include ../../mixin/alert.pug

block main
    +errorAlert(3000)
    +successAlert(3000)

    div(class="px-10 py-8 bg-n-50 shadow-n-500 shadow-xs rounded-t-2xl")
        .relative

            div(class="absolute top-0 right-10") 
                div(class="flex items-center justify-center gap-2 font-inter text-p-500")
                    div(class="relative flex size-3")
                        span(class="absolute inline-flex h-full w-full animate-ping rounded-full bg-p-500 opacity-75")
                        span(class="relative inline-flex size-3 rounded-full bg-p-500")

                    p Hoạt động 

            
            h3(class="text-lg font-semibold font-inter text-n-800 mb-5") Thông tin cá nhân
            form(action=`/user/edit/${khach_thue.KT_ID}?_method=PATCH` method="post" enctype="multipart/form-data")  
                div(class="grid grid-cols-2 gap-4 px-6")
                    .form-group

                        .form-control_info                      
                            label(for="KT_TEN") Họ và tên
                            input(type="text" id="KT_TEN" name="KT_TEN" value=khach_thue.KT_TEN) 

                        .form-control_info                          
                            label(for="KT_SDT") Số điện thoại 
                            input(type="text" id="KT_SDT" name="KT_SDT" value=khach_thue.KT_SDT) 

                        .form-control_info                          
                            label(for="KT_PHAI") Giới tính
                            select(name="KT_PHAI")
                                option(value="male") Nam 
                                option(value="female") Nữ   

                        .form-control_info 
                            label(for="KT_ANH") Ảnh 
                            div(class="flex gap-3") 
                                div(class="flex gap-2 items-center")  
                                    input(type="file" preview-image id="KT_ANH" name="KT_ANH" class="hidden" accept="image/*") 
                                    label(for="KT_ANH")
                                        div(class="flex flex-col items-center justify-center gap-2 font-inter text-5xl text-n-500 h-25 w-25 rounded-lg border border-dashed")
                                            i(class="fa-solid fa-cloud-arrow-up")
                                
                                img(src=khach_thue.KT_ANH alt="" preview class=`h-30 w-30 object-cover p-1 rounded-2xl bg-n-200 ${!khach_thue.KT_ANH?"hidden":""}`)
                         
                    .form-group

                        .form-control_info                      
                            label(for="KT_EMAIL") #[span.text-red-500 * ]Email đăng nhập
                            input(type="text" id="KT_EMAIL" name="KT_EMAIL" value=khach_thue.KT_EMAIL required) 
                        
                        .form-control_info                      
                            label(for="KT_CCCD") Căn cước công dân
                            input(type="text" id="KT_CCCD" name="KT_CCCD" value=khach_thue.KT_CCCD)

                        .form-control_info                          
                            label(for="KT_TRANGTHAI") Trạng thái
                            select(name="KT_TRANGTHAI")
                                option(value="active" selected=khach_thue.KT_TRANGTHAI=="active") Hoạt động 
                                option(value="inactive" selected=khach_thue.KT_TRANGTHAI=="inactive") Dừng hoạt động

                    .form-control_info.col-span-2                      
                        label(for="KT_DIACHI") Địa chỉ
                        textarea(id="KT_DIACHI" name="KT_DIACHI") #{khach_thue.KT_DIACHI} 
                  
                div(class="flex justify-end gap-3 mt-5") 
                    a(href="/user/info" class="btn-2 bg-gray-500 py-1 text-base") Quay về
                    button(type="submit" class="btn-2 py-1 text-base ") Cập nhật
        
           

                  
